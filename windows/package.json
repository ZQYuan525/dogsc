{
  "name": "dogsc-windows",
  "productName": "DogSC",
  "version": "0.1.2-win.1",
  "description": "DogSC 的 Windows 适配版：录屏、轻量剪辑、自动运镜与导出。原版由神烦老狗（laogou717）创作。",
  "author": "神烦老狗 (https://github.com/laogou717)",
  "homepage": "https://github.com/laogou717/dogsc",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "package": "electron-packager . DogSC --platform=win32 --arch=x64 --out=dist --overwrite --asar.unpack=**/*.node --extra-resource=../Resources --icon=assets/icon.ico --ignore=^/dist --ignore=^/docs --ignore=^/assets --ignore=^/start.bat"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0"
  }
}
